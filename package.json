{
  "name": "@lucascouts/claude-agent-tui",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.1",
  "description": "ACP agent that drives the Claude Code subscription TUI over a PTY, rendering Claude Code threads in Zed and other ACP-compatible clients.",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "claude-agent-tui": "dist/index.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist/",
    "!dist/tests/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run build && npm run start",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test": "npm run build && node --experimental-strip-types --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "acp",
    "agent",
    "anthropic",
    "zed",
    "tui",
    "typescript"
  ],
  "homepage": "https://github.com/lucascouts/claude-agent-tui#readme",
  "bugs": {
    "url": "https://github.com/lucascouts/claude-agent-tui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucascouts/claude-agent-tui.git"
  },
  "author": "lucascouts",
  "license": "Apache-2.0",
  "dependencies": {
    "@agentclientprotocol/sdk": "0.22.1",
    "@anthropic-ai/claude-agent-sdk": "0.3.165",
    "node-pty": "1.1.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.100.1",
    "@eslint/js": "10.0.1",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "eslint": "10.4.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.6.0",
    "prettier": "3.8.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
